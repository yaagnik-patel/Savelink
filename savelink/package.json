{
  "name": "savelink",
  "productName": "SaveLink",
  "version": "1.0.1",
  "description": "SaveLink desktop widget",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win nsis dir && node scripts/package-zip.js"
  },
  "build": {
    "appId": "com.savelink.app",
    "productName": "SaveLink",
    "publish": {
      "provider": "github",
      "owner": "yaagnik-patel",
      "repo": "Savelink"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SaveLink",
      "runAfterFinish": true,
      "artifactName": "SaveLink-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  }
}
